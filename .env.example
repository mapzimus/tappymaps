SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# New Pro checkout prices ($9/mo, $72/yr) + Classroom ($12/mo). Create these
# in Stripe Dashboard, then paste the price_… IDs here / into Vercel env.
# Legacy $5/$48 price IDs stay on existing subscribers only (grandfathered).
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_new_monthly_9_price_id
STRIPE_PRO_ANNUAL_PRICE_ID=price_your_new_annual_72_price_id
STRIPE_CLASSROOM_MONTHLY_PRICE_ID=price_your_classroom_12_price_id
